PORT=3000
# Obligatorio en producción: cadena aleatoria larga (openssl rand -hex 32)
SESSION_SECRET=
# URL pública (para mostrar los enlaces correctos detrás de un proxy)
PUBLIC_URL=https://leads.tudominio.com
# Base de datos en Turso (gratis). Si se dejan vacías, se usa un archivo local (DB_FILE).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_FILE=./data/leads.db
# Webhooks de Meta (Instagram + WhatsApp Cloud API)
META_VERIFY_TOKEN=
META_APP_SECRET=
